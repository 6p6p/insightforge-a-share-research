# InsightForge 应用配置（非敏感占位；真实密码仅放本地 .env）
APP_NAME=InsightForge
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_USER=insightforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=insightforge
POSTGRES_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg://insightforge:change_me@127.0.0.1:5433/insightforge
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --- Chroma ---
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
CHROMA_SSL=false
CHROMA_TIMEOUT_SECONDS=5
CHROMA_HOST_PORT=8002

# --- 原始文件归档存储 ---
RAW_STORAGE_ROOT=.data/raw
SOURCE_MAX_FILE_SIZE_BYTES=104857600
MACRO_MAX_JSON_RESPONSE_BYTES=5242880

# --- 确定性导出字节存储（stage 6C，内容寻址）---
EXPORT_STORAGE_ROOT=.data/exports

# --- 评估 benchmark workspace（stage 7B；可选）---
# 不设置时默认 repo 根 / benchmark/（CLI 产物与 Web 对比视图共享同一根目录）。
# EVAL_BENCHMARK_WORKSPACE=benchmark

# --- 工作流后台执行 ---
WORKFLOW_SHUTDOWN_TIMEOUT_SECONDS=10
WORKFLOW_RECONCILE_TIMEOUT_SECONDS=5

# --- LLM（stage 3C.2.1，DeepSeek）---
# 真实 key 只放本地 .env（不提交）；留空时应用仍可启动，real smoke 为
# pending_credentials。Secret 不进入日志 / 错误响应 / model_id / DB。
# DeepSeek 官方已停止 legacy model names（deepseek-chat / deepseek-reasoner），
# 当前统一使用 deepseek-v4-flash。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
DEEPSEEK_API_KEY=
