# --- 本地环境文件（保留 .env.example） ---
.env
.env.*
!.env.example

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*$py.class

# --- 测试 / 质量工具缓存 ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- 构建产物 ---
build/
dist/
*.egg-info/
*.egg

# --- IDE 本地配置 ---
.idea/
.vscode/
*.swp
*.swo

# --- 前端 ---
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# --- 日志 ---
*.log
logs/

# --- 运行时存储 / 导出 / 临时数据 ---
data/
.data/
exports/
*.tmp
*.temp
cache/
tmp/
tmp-test/

# --- Windows / macOS 系统文件 ---
Thumbs.db
Desktop.ini
.DS_Store

# --- AI coding agent / 本地工具配置（不进入公开仓库） ---
.claude/
.cursor/

# --- benchmark 运行时产物（dataset / run 输出，可重建） ---
/benchmark/
backend/*.txt
backend/_smoke*.py
backend/_dbg.py
backend/_l.py
backend/_r.py
backend/_tb.py
docker/overlay.Dockerfile
frontend/*.txt

# --- 内部研发过程记录（不对公开仓库公开展示；ADR 见 docs/decisions/ 保持公开） ---
docs/internal/

# --- AI 设计工具产物（design-tool studio 输出，非产品/架构文档） ---
design/